{
  "name": "la-pica-del-benjamin-desktop",
  "version": "1.1.4",
  "description": "Aplicación de escritorio La Picá del Benjamín",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "cl.lapicadelbenjamin.desktop",
    "productName": "La Pica del Benjamin",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "app/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "LaPicaDelBenjamin-Setup-${version}.${ext}",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "La Picá del Benjamín",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "quicksandyou",
        "repo": "menu-la-pica-del-benjamin"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  }
}
